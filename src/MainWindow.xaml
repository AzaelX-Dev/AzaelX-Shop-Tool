<ui:FluentWindow
    x:Class="LuaToolsGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    Title="AzaelX Shop — Tools"
    Icon="icon.ico"
    Width="1280"
    Height="820"
    MinWidth="900"
    MinHeight="640"
    Background="{DynamicResource AppBackgroundBrush}"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AzaelX Shop — Tools">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/AzaelX_Shop_Logo_Transparent.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}">
            <Border Width="280" HorizontalAlignment="Left" Background="{DynamicResource AppSidebarBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="0,0,1,0" />
            <!-- App content (nav rail + toasts). Blurred while the first-run welcome overlay is open. -->
            <Grid x:Name="AppContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Onboarding.IsOpen}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect KernelType="Gaussian" Radius="28" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            <!-- Fluent nav rail. Selection/highlight + page hosting are handled by the control. -->
            <ui:NavigationView
                x:Name="RootNavigation"
                Background="Transparent"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="False"
                OpenPaneLength="280"
                PaneDisplayMode="Left">
                <ui:NavigationView.Resources>
                    <Style TargetType="{x:Type ui:NavigationViewItemHeader}">
                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                        <Setter Property="FontSize" Value="10.5" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Margin" Value="18,13,8,4" />
                    </Style>
                    <Style TargetType="{x:Type ui:NavigationViewItemSeparator}">
                        <Setter Property="Margin" Value="14,7" />
                    </Style>
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#090D18" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#090D18" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#090D18" />
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#17253B" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundChecked" Color="#222D4A" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedPointerOver" Color="#2A3859" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#91A4BF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundChecked" Color="#29D9F2" />
                </ui:NavigationView.Resources>
                <ui:NavigationView.PaneHeader>
                    <Border Margin="14,10,14,16" Padding="12,13" Background="{DynamicResource AppSurfaceRaisedBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="54" Height="54" Source="pack://application:,,,/AzaelX_Shop_Logo_Transparent.png" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource AppTextBrush}" Text="AZAELX SHOP" />
                                <TextBlock Margin="0,3,0,0" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Text="GAME TOOLKIT" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ui:NavigationView.PaneHeader>
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItemHeader Text="{x:Static res:Strings.Nav_GroupLibrary}" />
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Home}" TargetPageType="{x:Type views:HomeView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Add}" TargetPageType="{x:Type views:DownloadView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Add24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Manage}" TargetPageType="{x:Type views:ManageView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Games24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Builds}" TargetPageType="{x:Type views:BuildsView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="BranchFork24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItemSeparator Margin="14,9" />
                    <ui:NavigationViewItemHeader Text="{x:Static res:Strings.Nav_GroupTools}" />
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Mode}" TargetPageType="{x:Type views:ModeView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Options24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Fixes}" TargetPageType="{x:Type views:FixesView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ShieldTask24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItemSeparator Margin="14,5" />
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Downloads}" TargetPageType="{x:Type views:DownloadsView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_Settings}" TargetPageType="{x:Type views:SettingsView}">
                        <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItemSeparator Margin="14,5" />
                    <ui:NavigationViewItem Margin="8,3" Padding="15,12" Content="{x:Static res:Strings.Nav_RestartSteam}" Click="RestartSteam_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>

                <!-- Always-visible version tag at the very bottom of the pane -->
                <ui:NavigationView.PaneFooter>
                    <StackPanel Margin="14,8,14,14">
                        <!-- Persistent creator/community link: promotes the owner's Discord on every page. -->
                        <Border Margin="0,0,0,12" Padding="10" Background="{DynamicResource AppTintBrush}"
                                BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="9">
                                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}" Symbol="Chat24" />
                                    </Border>
                                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Text="{x:Static res:Strings.App_Discord_Title}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="9.5" Foreground="{DynamicResource AppMutedBrush}" Text="{x:Static res:Strings.App_Discord_Hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <ui:Button Margin="0,9,0,0" HorizontalAlignment="Stretch" Appearance="Primary"
                                           Click="JoinDiscord_Click" Content="{x:Static res:Strings.App_Discord_Join}"
                                           Icon="{ui:SymbolIcon Open24}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="2,0,0,0" Orientation="Horizontal">
                            <Border
                                Width="9"
                                Height="9"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppAccentBrush}"
                                CornerRadius="4" />
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AppTextBrush}"
                                Text="AZAELX SHOP" />
                        </StackPanel>
                        <TextBlock
                            Margin="18,4,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource AppMutedBrush}"
                            Text="{Binding VersionLabel}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding VersionLabel}" />
                    </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <!-- Bottom-right toasts (attached to ToastService in App.OnStartup). Also hosts the
                 persistent "update ready" prompt with a Restart action. -->
            <ui:SnackbarPresenter
                x:Name="RootSnackbar"
                Margin="0,0,24,18"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" />
            </Grid>

            <!-- First-run welcome overlay (last child = top Z-order; covers the nav + page area). -->
            <views:OnboardingView
                DataContext="{Binding Onboarding}"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
