<Window
    x:Class="LuaToolsGui.Views.DeviceAuthorizationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    Title="{x:Static res:Strings.Auth_Title}"
    Width="570"
    Height="440"
    Background="{DynamicResource AppBackgroundBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="18"
        Padding="26"
        Background="{DynamicResource AppSurfaceBrush}"
        BorderBrush="{DynamicResource AppStrokeBrush}"
        BorderThickness="1"
        CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border
                    Width="48"
                    Height="48"
                    Background="{DynamicResource AppTintBrush}"
                    CornerRadius="14">
                    <Image
                        Margin="3"
                        Source="pack://application:,,,/AzaelX_Shop_AppIcon.png"
                        Stretch="Uniform" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AppTextBrush}"
                        Text="{x:Static res:Strings.Auth_Title}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource AppMutedBrush}"
                        Text="AzaelX-Tools" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="0,17,0,0"
                FontSize="13"
                Foreground="{DynamicResource AppMutedBrush}"
                Text="{x:Static res:Strings.Auth_Subtitle}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="2"
                Margin="0,19,0,7"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AppMutedBrush}"
                Text="{x:Static res:Strings.Auth_HwidLabel}" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="HardwareIdText"
                    MinHeight="40"
                    Padding="10,9"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource AppSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}"
                    FontFamily="Consolas"
                    FontSize="11"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="CopyButton"
                    Grid.Column="1"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Click="CopyButton_Click"
                    Content="{x:Static res:Strings.Auth_Copy}" />
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock
                    x:Name="StatusText"
                    FontSize="12.5"
                    Foreground="{DynamicResource AppWarningBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,9,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource AppMutedBrush}"
                    Text="{x:Static res:Strings.Auth_ListFormatHint}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="CheckButton"
                    Padding="14,9"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource AppAccentStrongBrush}"
                    BorderBrush="{DynamicResource AppAccentStrongBrush}"
                    Foreground="#FFFFFF"
                    Click="CheckButton_Click"
                    Content="{x:Static res:Strings.Auth_Check}" />
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="14,9"
                    Click="CloseButton_Click"
                    Content="{x:Static res:Strings.Auth_Close}" />
            </Grid>
        </Grid>
    </Border>
</Window>
