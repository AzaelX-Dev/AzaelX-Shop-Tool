<UserControl
    x:Class="LuaToolsGui.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="HomeStatusButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1120" Margin="24,26,24,40">

                <!-- AzaelX Shop command deck: neon brand, library count, and direct actions. -->
                <Border Padding="22" Background="{DynamicResource AppHeroBrush}" BorderBrush="{DynamicResource AppAccentStrongBrush}" BorderThickness="1" CornerRadius="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Border Width="140" Height="140" VerticalAlignment="Center" Background="#10060D18" BorderBrush="#4D29D9F2" BorderThickness="1" CornerRadius="23">
                            <Image Margin="4" Source="pack://application:,,,/AzaelX_Shop_Logo_Transparent.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,4,18,4" VerticalAlignment="Center" MaxWidth="560">
                            <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Text="AZAELX SHOP  /  GAMING TOOLKIT" />
                            <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Text="AzaelX-Tools" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource AppMutedBrush}" Text="{x:Static res:Strings.Home_Subtitle}" TextWrapping="Wrap" />
                            <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                                <ui:Button Appearance="Primary" Command="{Binding OpenManageCommand}" Content="{x:Static res:Strings.Nav_Manage}" Icon="{ui:SymbolIcon Games24}" />
                                <ui:Button Margin="9,0,0,0" Command="{Binding OpenModeCommand}" Content="{x:Static res:Strings.Nav_Mode}" Icon="{ui:SymbolIcon Options24}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="2" Padding="15" Background="{DynamicResource AppAccentStrongBrush}" BorderBrush="#7A29D9F2" BorderThickness="1" CornerRadius="21">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="23" Foreground="#FFFFFF" Symbol="Games24" />
                                <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="38" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding GameCount}" />
                                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" Text="{x:Static res:Strings.Home_LuasOnBoard}" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Status cards act as navigation shortcuts. -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource HomeStatusButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" Background="{DynamicResource AppTintBrush}" CornerRadius="14">
                                <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Symbol="Games24">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SteamFound}" Value="True">
                                                    <Setter Property="Foreground" Value="#18804B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" Text="{x:Static res:Strings.Home_SteamStatus}" />
                                <TextBlock Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" Text="{Binding SteamStatus}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedBrush}" Symbol="ArrowRight24" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding OpenModeCommand}" Style="{StaticResource HomeStatusButton}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" Background="{DynamicResource AppTintBrush}" CornerRadius="14">
                                <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource AppAccentBrush}" Symbol="Options24" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" Text="{x:Static res:Strings.Nav_Mode}" />
                                <TextBlock Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" Text="{Binding ModeStatus}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedBrush}" Symbol="ArrowRight24" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Quick install / add-game area -->
                <views:DropZone Margin="0,16,0,0" DataContext="{Binding Drop}" />

                <!-- Recent games as compact library cards. -->
                <StackPanel Margin="0,28,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Text="{x:Static res:Strings.Home_RecentlyAdded}" />
                        <ui:Button Grid.Column="1" Appearance="Secondary" Command="{Binding OpenManageCommand}" Content="{x:Static res:Strings.Nav_Manage}" Icon="{ui:SymbolIcon ArrowRight24}" />
                    </Grid>
                    <ItemsControl Margin="0,13,0,0" ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="204"
                                    Margin="0,0,12,12"
                                    Padding="0"
                                    Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    ToolTip="{x:Static res:Strings.Home_ViewDetails}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RecentCard" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="16">
                                                <StackPanel>
                                                    <Border Height="92" Background="{DynamicResource AppTintBrush}" ClipToBounds="True" CornerRadius="15,15,0,0">
                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Grid Margin="12,10,12,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}" Symbol="ArrowRight24" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RecentCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                                    <Setter TargetName="RecentCard" Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <views:ConfirmOverlay DataContext="{Binding Drop}" />
    </Grid>
</UserControl>
