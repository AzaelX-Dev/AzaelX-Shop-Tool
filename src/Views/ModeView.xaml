<UserControl
    x:Class="LuaToolsGui.Views.ModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ModeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Fixed bottom dock reserved for the shared install progress indicator. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" Margin="24,22,24,18">

                <Border Padding="22,19" Background="{DynamicResource AppHeroBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="22">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="11">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}" Symbol="Options24" />
                                </Border>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Text="{x:Static res:Strings.Mode_Title}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource AppMutedBrush}" Text="{x:Static res:Strings.Mode_Subtitle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CheckForUpdatesCommand}" Content="{x:Static res:Strings.Mode_CheckForUpdates}" Icon="{ui:SymbolIcon ArrowSync24}" IsEnabled="{Binding NotBusy}" />
                    </Grid>
                </Border>

                <!-- Mode selector: separate backend cards with their own status and action area. -->
                <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource AppSurfaceRaisedBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="19">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,10" Padding="17" MinHeight="238" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" Background="{DynamicResource AppTintBrush}" CornerRadius="13">
                                                <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Foreground="{DynamicResource AppAccentBrush}" Symbol="Wrench24" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Text="{Binding Title}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,5,0,0">
                                                    <Border Margin="0,0,5,4" Padding="7,3" Background="#DDF8E8" CornerRadius="6" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon VerticalAlignment="Center" FontSize="10" Foreground="#18804B" Symbol="Checkmark24" /><TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#18804B" Text="{x:Static res:Strings.Mode_Active}" /></StackPanel>
                                                    </Border>
                                                    <Border Margin="0,0,5,4" Padding="7,3" Background="{DynamicResource AppTintBrush}" CornerRadius="6" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" Symbol="Star24" /><TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Text="{x:Static res:Strings.Mode_Recommended}" /></StackPanel>
                                                    </Border>
                                                    <Border Margin="0,0,5,4" Padding="7,3" Background="#FFF3D8" CornerRadius="6" Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon VerticalAlignment="Center" FontSize="10" Foreground="#B7790F" Symbol="Warning24" /><TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#B7790F" Text="{x:Static res:Strings.Mode_Experimental}" /></StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,13,0,13">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                            <Border Margin="0,10,0,0" Padding="10,8" Background="{DynamicResource AppSurfaceRaisedBrush}" CornerRadius="9">
                                                <TextBlock FontSize="11.5" Foreground="{DynamicResource AppMutedBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Appearance="Primary" Command="{Binding DataContext.InstallCommand, ElementName=Root}" CommandParameter="{Binding}" Content="{Binding ButtonText}" IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" MaxWidth="1040" Margin="28,0,28,18">
            <ProgressBar Height="5" Margin="0,2,0,0"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Maximum="100" Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Steam-shutdown confirmation overlay (covers the whole page, both rows) -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="#99000000"
            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
            <Border
                MaxWidth="420"
                Margin="8"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding ConfirmTitle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12.5"
                        Foreground="{DynamicResource AppMutedBrush}"
                        Text="{x:Static res:Strings.Mode_Confirm_Body}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding CancelConfirmCommand}"
                            Content="{x:Static res:Strings.Mode_Cancel}" />
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ConfirmInstallCommand}"
                            Content="{x:Static res:Strings.Mode_CloseSteamContinue}"
                            Icon="{ui:SymbolIcon Power24}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
