<UserControl
    x:Class="LuaToolsGui.Views.DropZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DropInstallViewModel}"
    AllowDrop="True"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">

    <Grid>
        <Border
            MinHeight="132"
            Padding="18"
            BorderThickness="1.5"
            CornerRadius="20"
            SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
                    <Setter Property="BorderBrush" Value="#C8E6FC" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="Background" Value="#E1F3FF" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentStrongBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="2"
                    Width="66"
                    Height="66"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppTintBrush}"
                    CornerRadius="18">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Foreground="{DynamicResource AppAccentBrush}"
                        Symbol="ArrowDownload24" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,2,18,2" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextBrush}"
                        Text="{x:Static res:Strings.Drop_Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource AppMutedBrush}"
                        Text="{x:Static res:Strings.Drop_LinkHint}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ui:Button
                    Grid.Column="2"
                    MinWidth="142"
                    Padding="15,11"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Click="OnBrowseClick"
                    Content="{x:Static res:Strings.Drop_BrowseFiles}"
                    Icon="{ui:SymbolIcon FolderOpen24}" />

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="16,10,0,0"
                    Padding="10,7"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="12"
                        Text="{Binding ResultText}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#18804B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#A95A0A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
