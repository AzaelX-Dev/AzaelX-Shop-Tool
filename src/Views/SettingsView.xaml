<UserControl
    x:Class="LuaToolsGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        mc:Ignorable="d">

    <UserControl.Resources>
        <EllipseGeometry x:Key="AccountAvatarClip" Center="31,31" RadiusX="31" RadiusY="31" />
        <!-- Section card: one bordered container that groups a section's rows. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <!-- Section header (small grey uppercase label above each card). -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,28,0,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        </Style>
        <!-- Thin divider between rows inside a card. -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppStrokeBrush}" />
            <Setter Property="Margin" Value="14,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1080" Margin="26,24,26,40">
            <TextBlock
                FontSize="30"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Settings_Title}" />

            <!-- LuaTools account: protected manifest sources and OnlineFix downloads require a user session. -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Account}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="18,14">
                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Background="{DynamicResource AppSurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding LoginRequiredMessage, Converter={StaticResource NullToCollapsed}}">
                        <DockPanel LastChildFill="True">
                            <ui:Button
                                DockPanel.Dock="Right"
                                Appearance="Secondary"
                                Command="{Binding DismissLoginRequiredCommand}"
                                Content="×"
                                Padding="8,2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AppAccentBrush}"
                                Text="{Binding LoginRequiredMessage}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Static res:Strings.Settings_BrowsingAsGuest}" />
                        <TextBlock
                            Margin="0,5,0,12"
                            Foreground="{DynamicResource AppMutedBrush}"
                            Text="{x:Static res:Strings.Settings_GuestHint}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            HorizontalAlignment="Left"
                            Command="{Binding SignInCommand}"
                            Content="{x:Static res:Strings.Settings_SignInDiscord}"
                            Icon="{ui:SymbolIcon Open24}" />

                        <TextBlock
                            Margin="0,14,0,6"
                            Foreground="{DynamicResource AppMutedBrush}"
                            Text="{x:Static res:Strings.Settings_BotCode_Hint}"
                            TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                MinWidth="160"
                                MaxWidth="260"
                                Padding="10,7"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource AppSurfaceBrush}"
                                Foreground="{DynamicResource AppTextBrush}"
                                BorderBrush="{DynamicResource AppStrokeBrush}"
                                Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="6"
                                CharacterCasing="Upper"
                                ToolTip="{x:Static res:Strings.Settings_BotCode_Placeholder}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding SignInWithCodeCommand}"
                                IsEnabled="{Binding CanRedeemCode}"
                                Content="{x:Static res:Strings.Settings_BotCode_Redeem}" />
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="#F87171"
                            Text="{Binding CodeError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding CodeError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRealUser, Converter={StaticResource BoolToVis}}">
                        <!-- Discord identity card: bind the cached profile URL from the existing auth session. -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="68" Height="68" Padding="2" VerticalAlignment="Center"
                                    Background="{DynamicResource AppTintBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1.5" CornerRadius="34">
                                <Grid Width="62" Height="62">
                                    <Ellipse Fill="{DynamicResource AppSurfaceRaisedBrush}" />
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                                   Foreground="{DynamicResource AppAccentBrush}" Symbol="Person24">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AvatarUrl}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <Image Width="62" Height="62" Source="{Binding AvatarUrl}" Stretch="UniformToFill"
                                           Clip="{StaticResource AccountAvatarClip}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock FontSize="19" FontWeight="Bold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"
                                           Text="{Binding Email}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Padding="10,6" VerticalAlignment="Center"
                                    Background="{DynamicResource AppTintBrush}" BorderBrush="{DynamicResource AppStrokeBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource AppSuccessBrush}" Symbol="CheckmarkCircle24" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                               Text="{x:Static res:Strings.Settings_AccountConnected}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- A bot-provisioned Discord session is not always a fully linked LuaTools account. -->
                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{DynamicResource AppSurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ShowBotLinkBanner, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Static res:Strings.Settings_BotLink_Title}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource AppMutedBrush}"
                                        Text="{x:Static res:Strings.Settings_BotLink_Body}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,12,0,6"
                                    Foreground="{DynamicResource AppMutedBrush}"
                                    Text="{x:Static res:Strings.Settings_BotCode_Hint}"
                                    TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        MinWidth="160"
                                        MaxWidth="260"
                                        Padding="10,7"
                                        VerticalContentAlignment="Center"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        Foreground="{DynamicResource AppTextBrush}"
                                        BorderBrush="{DynamicResource AppStrokeBrush}"
                                        Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}"
                                        MaxLength="6"
                                        CharacterCasing="Upper"
                                        ToolTip="{x:Static res:Strings.Settings_BotCode_Placeholder}" />
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding SignInWithCodeCommand}"
                                        IsEnabled="{Binding CanRedeemCode}"
                                        Content="{x:Static res:Strings.Settings_BotCode_Redeem}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="#F87171"
                                    Text="{Binding CodeError}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding CodeError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <ui:Button
                            HorizontalAlignment="Left"
                            Appearance="Secondary"
                            Command="{Binding SignOutCommand}"
                            Content="{x:Static res:Strings.Settings_SignOut}"
                            Icon="{ui:SymbolIcon SignOut24}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hubcap API key -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Hubcap}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="18,14">
                    <!-- Active key: stats card -->
                    <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource BoolToVis}}">
                        <!-- Active badge + Refresh -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                HorizontalAlignment="Left"
                                Appearance="Secondary"
                                Command="{Binding RefreshHubcapStatsCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapRefresh}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Grid.Column="1"
                                Command="{Binding ClearHubcapKeyCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapClear}"
                                Icon="{ui:SymbolIcon Dismiss24}" />
                        </Grid>
                        <!-- Usage progress card -->
                        <Border Margin="0,0,0,10" Padding="12" Background="{DynamicResource AppSurfaceRaisedBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding ShowHubcapStats, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Real ProgressBar (Fluent-styled, same as ModeView/FixesView).
                                     HubcapUsagePercent is 0.0–1.0, so Maximum="1"; ProgressBar clamps past it.
                                     Indeterminate (animated) until stats load, so the card is never blank. -->
                                <ProgressBar
                                    Height="6"
                                    IsIndeterminate="{Binding HubcapStatsPending}"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="{Binding HubcapUsagePercent, Mode=OneWay}" />
                                <TextBlock Margin="0,8,0,0" FontSize="13"
                                           Text="{Binding HubcapStatsText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0" FontSize="12"
                                           Foreground="{DynamicResource AppMutedBrush}"
                                           Text="{Binding HubcapResetCountdown}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Key input: only while NO key is saved. Once configured, the Refresh/Clear buttons +
                         usage card above are the whole story; "Clear" is how you swap keys (it resets
                         HubcapIsKeyConfigured, bringing this block back). The onboarding copy below reads
                         wrong when a key already exists, hence the collapse. -->
                    <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{x:Static res:Strings.Settings_HubcapKey}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource AppMutedBrush}"
                            Text="{x:Static res:Strings.Settings_HubcapKey_Hint}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                FontFamily="Consolas"
                                PlaceholderText="{x:Static res:Strings.Settings_HubcapKeyPlaceholder}"
                                Text="{Binding HubcapKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Command="{Binding ValidateAndSaveHubcapKeyCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapValidate}"
                                IsEnabled="{Binding CanEditHubcapKey}" />
                        </Grid>
                        <!-- Error text (only ever set by the two ValidateAndSaveHubcapKeyAsync failure paths,
                             so it can never be orphaned by this collapse). -->
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{Binding HubcapKeyStatusColor}"
                            Text="{Binding HubcapKeyStatus}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HubcapKeyStatus, Converter={StaticResource NullToCollapsed}}" />
                        <!-- "Get a key" link -->
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource AppMutedBrush}">
                            <Run Text="{x:Static res:Strings.Settings_HubcapGetKey}" />
                            <Hyperlink Command="{Binding OpenHubcapCommand}" Foreground="{DynamicResource AppAccentBrush}">hubcapmanifest.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Install behavior -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Install}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Auto Update Apps -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_AutoUpdateApps}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource AppMutedBrush}"
                                Text="{x:Static res:Strings.Settings_AutoUpdateApps_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding AutoUpdateApps, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General (language) -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_General}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Live theme preference. This changes only the palette, not application services. -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Text="{x:Static res:Strings.Settings_Appearance}" />
                            <TextBlock Margin="0,4,12,0" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Text="{x:Static res:Strings.Settings_Appearance_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.Settings_DarkMode}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <!-- Language: same two-column alignment as the other settings rows. -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_Language}" />
                            <TextBlock
                                Margin="0,4,12,0"
                                FontSize="12"
                                Foreground="{DynamicResource AppMutedBrush}"
                                Text="{x:Static res:Strings.Settings_Language_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource ThemeAwareSettingsComboBox}"
                            Foreground="{DynamicResource AppTextBrush}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Width="190"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding LanguageOptions}"
                            SelectedItem="{Binding SelectedLanguage}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <!-- DNS resolution. Defaults to Automatic; see AppHttp for what each mode does. -->
                    <StackPanel Margin="18,14">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{x:Static res:Strings.Settings_Dns}" />
                        <ComboBox
                            Margin="0,8,0,0"
                            Style="{StaticResource ThemeAwareSettingsComboBox}"
                            Foreground="{DynamicResource AppTextBrush}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            MinWidth="220"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding DnsModeOptions}"
                            SelectedItem="{Binding SelectedDnsMode}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource AppMutedBrush}"
                            Text="{x:Static res:Strings.Settings_Dns_Hint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Steam -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Steam}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="18,14">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{x:Static res:Strings.Settings_SteamLocation}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            IsReadOnly="True"
                            Text="{Binding SteamPath, Mode=OneWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding OverrideSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Change}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Command="{Binding OpenSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Open}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            Command="{Binding ClearSteamOverrideCommand}"
                            Content="{x:Static res:Strings.Settings_ResetToAuto}"
                            Visibility="{Binding IsSteamOverridden, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource AppMutedBrush}"
                        Text="{Binding SteamSource}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource AppDangerBrush}"
                        Text="{Binding SteamWarning}"
                        TextWrapping="Wrap"
                        Visibility="{Binding SteamWarning, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- Startup -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Startup}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Start with Windows -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_StartWithWindows}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource AppMutedBrush}"
                                Text="{x:Static res:Strings.Settings_StartWithWindows_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <!-- Minimize to System Tray -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_MinimizeToTray}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource AppMutedBrush}"
                                Text="{x:Static res:Strings.Settings_MinimizeToTray_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The service stays on its existing background path; keep the opt-out visible and clear. -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Community}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}" Symbol="CloudArrowUp24" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_DonateKeys}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource AppMutedBrush}"
                            Text="{x:Static res:Strings.Settings_DonateKeys_Hint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding DonateKeys, Mode=TwoWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
