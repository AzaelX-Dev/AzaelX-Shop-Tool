<ui:FluentWindow
    x:Class="LuaToolsGui.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.Update_Title}"
    Icon="pack://application:,,,/icon.ico"
    Width="560" Height="440" MinWidth="560" MinHeight="440"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackgroundBrush}"
    WindowCornerPreference="Round">
    <Border Margin="14" Padding="22"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppStrokeBrush}"
            BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="15"
                        Background="{DynamicResource AppTintBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1">
                    <Image Margin="4" Source="pack://application:,,,/AzaelX_Shop_Logo_Transparent.png" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"
                               Text="{x:Static res:Strings.Update_Eyebrow}" />
                    <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextBrush}"
                               Text="{x:Static res:Strings.Update_Title}" />
                </StackPanel>
                <Border Grid.Column="2" Padding="9,5" VerticalAlignment="Top"
                        Background="{DynamicResource AppTintBrush}" CornerRadius="7">
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Text="UPDATE" />
                </Border>
            </Grid>

            <TextBlock Grid.Row="1" Margin="0,18,0,0" FontSize="12.5"
                       Foreground="{DynamicResource AppMutedBrush}"
                       Text="{x:Static res:Strings.Update_AvailableBody}"
                       TextWrapping="Wrap" />

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="14"
                    Background="{DynamicResource AppSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}"
                                   Text="{x:Static res:Strings.Update_CurrentVersion}" />
                        <TextBlock x:Name="CurrentVersionValue" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"
                                   Text="{x:Static res:Strings.Update_NewVersion}" />
                        <TextBlock x:Name="NewVersionValue" Margin="0,5,0,0" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,16,0,0" VerticalAlignment="Top">
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{DynamicResource AppTextBrush}"
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="DownloadProgress" Margin="0,12,0,0" Height="8" Minimum="0" Maximum="100"
                             Background="{DynamicResource AppSurfaceRaisedBrush}"
                             Foreground="{DynamicResource AppAccentBrush}"
                             Visibility="Collapsed" />
                <TextBlock x:Name="ProgressText" Margin="0,6,0,0" FontSize="11" TextAlignment="Right"
                           Foreground="{DynamicResource AppMutedBrush}" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" MinWidth="110" Margin="0,0,9,0" Padding="14,9"
                        Click="LaterButton_Click" Content="{x:Static res:Strings.Update_ButtonLater}" />
                <Button x:Name="UpdateButton" MinWidth="145" Padding="16,9"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}"
                        Click="UpdateButton_Click" Content="{x:Static res:Strings.Update_ButtonNow}" />
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
