<UserControl
    x:Class="LuaToolsGui.Views.DownloadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DownloadViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One diff row: clickable → SteamDB. Real name on top, "id · size · OS · lang" below, DLC/SHARED chip right. -->
        <DataTemplate x:Key="DiffRowTemplate">
            <Button
                Margin="0,0,0,2"
                Padding="6,4"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding DataContext.OpenSteamDbCommand, ElementName=Root}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{DynamicResource AppTextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource AppMutedBrush}"
                                        Text="{Binding Meta}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,1,0,0"
                                    Padding="5,1"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AppTintBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AppAccentBrush}"
                                        Text="DLC" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,1,0,0"
                                    Padding="5,1"
                                    VerticalAlignment="Top"
                                    Background="#FFF3D8"
                                    CornerRadius="4"
                                    Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        Foreground="#916500"
                                        Text="{x:Static res:Strings.Confirm_Shared}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Featured item: cinematic capsule art, platform tag, title and AppID. Click route remains unchanged. -->
        <DataTemplate x:Key="FeaturedCardTemplate">
            <Button Width="210" Margin="0,0,12,14" Padding="0"
                    HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                    Command="{Binding DataContext.SelectFeaturedCommand, ElementName=Root}"
                    CommandParameter="{Binding}" Cursor="Hand" ToolTip="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="18">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="124" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" ClipToBounds="True">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                    <Border Height="38" VerticalAlignment="Bottom">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#00060B18" />
                                                <GradientStop Offset="1" Color="#E0060B18" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border Margin="8" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="#CC07111E" BorderBrush="#6639DAF4" BorderThickness="1" CornerRadius="5">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="#65E8FF" Text="STEAM DISCOVERY" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="11,10,11,12">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"
                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource AppMutedBrush}"
                                                   Text="{x:Static res:Strings.Add_FeaturedAppId}" />
                                        <TextBlock Margin="4,0,0,0" FontSize="10.5" Foreground="{DynamicResource AppMutedBrush}"
                                                   Text="{Binding AppId}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- New releases use a compact landscape tile, so the discovery area has a different visual rhythm. -->
        <DataTemplate x:Key="NewReleaseCardTemplate">
            <Button Width="214" Margin="0,0,10,10" Padding="0" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding Name}"
                    Command="{Binding DataContext.SelectFeaturedCommand, ElementName=Root}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ReleaseCard" Padding="9" Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="70" Height="72" Background="{DynamicResource AppTintBrush}" CornerRadius="9" ClipToBounds="True">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,2,0,2" VerticalAlignment="Center">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"
                                               Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="38" />
                                    <TextBlock Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource AppAccentBrush}"
                                               Text="{x:Static res:Strings.Add_FeaturedAppId}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource AppMutedBrush}"
                                               Text="{Binding AppId}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ReleaseCard" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="ReleaseCard" Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ReleaseCard" Property="BorderBrush" Value="{DynamicResource AppAccentStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" Margin="24,22,24,38">

            <!-- AzaelX Shop storefront header: the logo anchors a Steam-inspired discovery flow. -->
            <Border
                Padding="20"
                Background="{DynamicResource AppHeroBrush}"
                BorderBrush="{DynamicResource AppAccentStrongBrush}"
                BorderThickness="1"
                CornerRadius="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="128" Height="128" VerticalAlignment="Center" Background="#10060D18" BorderBrush="#4D29D9F2" BorderThickness="1" CornerRadius="22">
                        <Image Margin="5" Source="pack://application:,,,/AzaelX_Shop_Logo_Transparent.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,2,2,2" VerticalAlignment="Center">
                        <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Text="{x:Static res:Strings.Add_StoreEyebrow}" />
                        <TextBlock Margin="0,7,0,0" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Text="{x:Static res:Strings.Add_Title}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,12" FontSize="12.5" Foreground="{DynamicResource AppMutedBrush}" Text="{x:Static res:Strings.Add_Subtitle}" TextWrapping="Wrap" />
                        <Border Padding="6" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="13">
                            <ui:TextBox
                                MinHeight="42"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="{x:Static res:Strings.Add_SearchPlaceholder}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Autocomplete results -->
            <Border
                Margin="0,6,0,0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsResultsOpen, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="4,2"
                                Padding="8,7"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.SelectResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="68"
                                        Height="38"
                                        CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource AppMutedBrush}"
                                        Text="{Binding AppId}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- A catalogue wall, not a horizontal banner carousel: two independent collections wrap into cards. -->
            <Grid Margin="0,20,0,0" Visibility="{Binding ShowFeatured, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="15" Background="{DynamicResource AppSurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="20"
                        Visibility="{Binding HasTopSellers, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border Width="4" Height="24" Margin="0,0,10,0" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" />
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"
                                           Text="{x:Static res:Strings.Add_Featured_TopSellers}" />
                                <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource AppMutedBrush}" Text="CURATED BY STEAM" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                      ItemTemplate="{StaticResource FeaturedCardTemplate}" ItemsSource="{Binding TopSellers}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="14,0,0,0" Padding="15" Background="{DynamicResource AppSurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="1" CornerRadius="20"
                        Visibility="{Binding HasNewReleases, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border Width="4" Height="24" Margin="0,0,10,0" Background="{DynamicResource AppAccentStrongBrush}" CornerRadius="2" />
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"
                                           Text="{x:Static res:Strings.Add_Featured_NewReleases}" />
                                <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource AppMutedBrush}" Text="FRESH ON STEAM" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                      ItemTemplate="{StaticResource NewReleaseCardTemplate}" ItemsSource="{Binding NewReleases}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Selected game workspace: artwork and install controls are grouped in one side-by-side panel. -->
            <Border
                Margin="0,14,0,0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppStrokeBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" MinHeight="220" Background="{DynamicResource AppTintBrush}" CornerRadius="19,0,0,19" ClipToBounds="True">
                        <Image Source="{Binding Details.HeaderImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="22,20,22,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" Text="{Binding Details.Name}" TextWrapping="Wrap" />
                            <Border Margin="9,0,0,0" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource AppTintBrush}" CornerRadius="6" Visibility="{Binding Details.IsDlc, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Text="DLC" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource AppMutedBrush}">
                            <Run Text="{Binding Details.AppId, Mode=OneWay}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding GenresText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource AppMutedBrush}" Text="{Binding Details.ReleaseDate, StringFormat={x:Static res:Strings.Add_Released}}" Visibility="{Binding Details.ReleaseDate, Converter={StaticResource NullToCollapsed}}" />

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Add Game action bar stays outside the game-detail card: same command bindings and
                 full-width click target as the previously working flow, styled to match Sky UI. -->
            <Border
                Margin="0,12,0,0"
                Padding="16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Button
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Padding="16,11"
                        Appearance="Primary"
                        Command="{Binding InstallCommand}"
                        Icon="{ui:SymbolIcon ArrowDownload24}">
                        <ui:Button.Content>
                            <Grid>
                                <TextBlock Text="{x:Static res:Strings.Add_Install}" Visibility="{Binding IsChecking, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="{x:Static res:Strings.Add_Checking}" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </ui:Button.Content>
                    </ui:Button>
                    <TextBlock
                        Grid.Row="1"
                        Margin="2,10,2,0"
                        FontSize="11"
                        Foreground="{DynamicResource AppMutedBrush}"
                        Text="{x:Static res:Strings.Add_WorkflowHint}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Error -->
            <TextBlock
                Margin="0,12,0,0"
                FontSize="13"
                Foreground="{DynamicResource AppDangerBrush}"
                Text="{Binding Error}"
                TextWrapping="Wrap"
                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <!-- Install result banner (green on success, amber on partial/failed) -->
            <Border
                Margin="0,12,0,0"
                Padding="12,9"
                CornerRadius="8"
                Visibility="{Binding HasInstallResult, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1422c55e" />
                        <Setter Property="BorderBrush" Value="#DDF8E8" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallFailed}" Value="True">
                                <Setter Property="Background" Value="#FFF0DF" />
                                <Setter Property="BorderBrush" Value="#FFF0DF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <!-- Success: green check. Failure: orange warning (matches the banner tint). -->
                                <Setter Property="Foreground" Value="#18804B" />
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InstallFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#A95A0A" />
                                        <Setter Property="Symbol" Value="Warning24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{Binding InstallStatus}"
                        TextWrapping="Wrap" />
                    <!-- Reveal only makes sense on a successful install. -->
                    <ui:Button
                        Grid.Column="2"
                        Command="{Binding RevealInstalledCommand}"
                        Content="{x:Static res:Strings.Add_Reveal}"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Visibility="{Binding InstallFailed, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </Border>

            <!-- Manifest sources -->
            <ItemsControl
                Margin="0,12,0,0"
                ItemsSource="{Binding Sources}"
                Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,9"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13.5"
                                            FontWeight="Medium"
                                            Text="{Binding DisplayName}" />
                                    </StackPanel>

                                    <!-- Usage + supporter badges -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Border
                                            Padding="6,2"
                                            Background="#1422c55e"
                                            BorderBrush="#DDF8E8"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding StatsText, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#18804B"
                                                Text="{Binding StatsText}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Status badge -->
                                    <Border
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}">
                                        <Border.BorderBrush>
                                            <Binding Converter="{StaticResource StatusToBrush}" Path="Status" />
                                        </Border.BorderBrush>
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                            Text="{Binding StatusLabel}" />
                                    </Border>
                                    <!-- Source community / documentation, when provided by the backend catalogue. -->
                                    <ui:Button
                                        Grid.Column="3"
                                        Margin="0,0,6,0"
                                        Padding="8,4"
                                        Appearance="Secondary"
                                        Command="{Binding OpenDiscordCommand}"
                                        Content="{x:Static res:Strings.Add_SourceDiscord}"
                                        Icon="{ui:SymbolIcon Open24}"
                                        Visibility="{Binding DiscordUrl, Converter={StaticResource NullToCollapsed}}" />

                                    <!-- Source-specific download button; command retains auth and key checks. -->
                                    <ui:Button
                                        Grid.Column="4"
                                        Padding="10,4"
                                        Appearance="Primary"
                                        Command="{Binding DownloadCommand}"
                                        Content="{x:Static res:Strings.Add_Download}"
                                        Icon="{ui:SymbolIcon ArrowDownload24}"
                                        IsEnabled="{Binding CanDownload}" />
                                </Grid>

                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource AppAccentBrush}"
                                    Text="{Binding AccessHint}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding ShowAccessHint, Converter={StaticResource BoolToVis}}" />

                                <!--  Progress is owned by the shared download queue; this row is just a view onto it.  -->
                                <ProgressBar
                                    Margin="0,8,0,0"
                                    IsIndeterminate="{Binding QueueItem.IsIndeterminate, FallbackValue=False}"
                                    Maximum="100"
                                    Visibility="{Binding QueueItem.ShowProgress, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                    Value="{Binding QueueItem.Percent, Mode=OneWay, FallbackValue=0}" />

                                <StackPanel
                                    Margin="0,5,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding QueueItem.ShowProgress, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding QueueItem.SizeLabel}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding QueueItem.RateLabel}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding QueueItem.EtaLabel}" />
                                </StackPanel>

                                <!--  Queued behind something else: say so, since nothing is moving yet.  -->
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding QueueItem.StatusLabel}"
                                    Visibility="{Binding QueueItem.CanReorder, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- DLC info -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasDlcInfo, Converter={StaticResource BoolToVis}}">
                <!-- Stat tiles -->
                <UniformGrid Columns="3">
                    <Border
                        Margin="0,0,4,0"
                        Padding="0,10"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{DynamicResource AppAccentBrush}"
                                Text="{Binding DlcInfo.DepotCount}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource AppMutedBrush}"
                                Text="{x:Static res:Strings.Add_Depots}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="4,0"
                        Padding="0,10"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#18804B"
                                Text="{Binding DlcInfo.HaveCount}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource AppMutedBrush}"
                                Text="{x:Static res:Strings.Add_Available}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="4,0,0,0"
                        Padding="0,10"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#B86108"
                                Text="{Binding DlcInfo.MissingCount}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource AppMutedBrush}"
                                Text="{x:Static res:Strings.Add_Missing}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Depot list -->
                <ItemsControl
                    MaxHeight="220"
                    Margin="0,10,0,0"
                    ItemsSource="{Binding DlcDepots}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <!-- Right margin keeps the scrollbar in its own lane instead of sitting on the rows. -->
                                <ItemsPresenter Margin="0,0,12,0" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,5"
                                Padding="10,6"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFF0DF" />
                                        <Setter Property="BorderBrush" Value="#FFF0DF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Included}" Value="True">
                                                <Setter Property="Background" Value="#DDF8E8" />
                                                <Setter Property="BorderBrush" Value="#DDF8E8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12.5"
                                        Text="{Binding DepotId}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,10,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource AppMutedBrush}"
                                        Text="{Binding Meta}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="#B86108"
                                        Text="{x:Static res:Strings.Add_NoKey}"
                                        Visibility="{Binding Included, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{DynamicResource AppMutedBrush}"
                    Text="{x:Static res:Strings.Add_DlcHint}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Already have files? Drag them in -->
            <TextBlock
                Margin="0,24,0,0"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AppTextBrush}"
                Text="{x:Static res:Strings.Add_AlreadyHaveFiles}" />
            <views:DropZone Margin="0,8,0,0" DataContext="{Binding Drop}" />
        </StackPanel>
    </ScrollViewer>

    <!-- Overwrite confirm: dim scrim + centered before/after diff -->
    <Grid
        Background="#99000000"
        Visibility="{Binding IsConfirmingOverwrite, Converter={StaticResource BoolToVis}}">
        <Border
            Width="460"
            MaxHeight="560"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppStrokeBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="17"
                    FontWeight="Bold"
                    Text="{Binding ConfirmTitle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource AppMutedBrush}"
                    Text="{x:Static res:Strings.Confirm_ReviewChanges}" />

                <ScrollViewer
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <!-- Right margin keeps the scrollbar in its own lane instead of sitting on the rows. -->
                    <StackPanel Margin="0,0,12,0">
                        <!-- No changes note -->
                        <TextBlock
                            FontSize="12.5"
                            Foreground="{DynamicResource AppMutedBrush}"
                            Text="{Binding ConfirmNoChanges}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ConfirmNoChanges, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Adding -->
                        <StackPanel Visibility="{Binding HasDiffAdded, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#18804B"
                                Text="{Binding DiffAdded.Count, StringFormat={x:Static res:Strings.Confirm_Adding}}" />
                            <ItemsControl
                                Margin="0,6,0,0"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding DiffAdded}" />
                        </StackPanel>

                        <!-- Removing -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasDiffRemoved, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AppWarningBrush}"
                                Text="{Binding DiffRemoved.Count, StringFormat={x:Static res:Strings.Confirm_Removing}}" />
                            <ItemsControl
                                Margin="0,6,0,0"
                                ItemTemplate="{StaticResource DiffRowTemplate}"
                                ItemsSource="{Binding DiffRemoved}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding CancelOverwriteCommand}"
                        Content="{x:Static res:Strings.Mode_Cancel}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ConfirmOverwriteCommand}"
                        Content="{x:Static res:Strings.Confirm_Replace}"
                        Icon="{ui:SymbolIcon ArrowDownload24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Drag-and-drop overwrite confirm (the DropZone's own flow), page-spanning. -->
    <views:ConfirmOverlay DataContext="{Binding Drop}" />
    </Grid>
</UserControl>
