<Application
    x:Class="LuaToolsGui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:LuaToolsGui"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:StatusToBrushConverter x:Key="StatusToBrush" />
            <local:ImagePathToSourceConverter x:Key="ImagePathToSource" />
            <local:EqualityMultiConverter x:Key="EqualityMulti" />
            <local:MinHeightToVisibilityConverter x:Key="MinHeightToVis" />
            <local:FilterOptionDisplayConverter x:Key="FilterOptionDisplay" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- AzaelX Shop neon palette. AppThemeService swaps these resources at runtime. -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#101525" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#161E31" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="#080D18" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#111A2C" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="#29364F" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#29D9F2" />
            <SolidColorBrush x:Key="AppAccentStrongBrush" Color="#8A55FF" />
            <SolidColorBrush x:Key="AppTintBrush" Color="#172A43" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#EAF4FF" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#91A4BF" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#47DBA0" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#FFC16D" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#FF7187" />
            <SolidColorBrush x:Key="AppPressedBrush" Color="#263D5E" />
            <SolidColorBrush x:Key="AppNavPointerBrush" Color="#17253B" />
            <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#222D4A" />

            <!-- WPF-UI semantic palette overrides; replacing these makes built-in controls theme-aware. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#29D9F2" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8A55FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#263D5E" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#07111E" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EAF4FF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9B8CE" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#91A4BF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#161E31" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#172A43" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#29364F" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#394969" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#111A2C" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#101525" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#161E31" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#172A43" />
            <LinearGradientBrush x:Key="AppHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#11152B" />
                <GradientStop Offset="0.52" Color="#172140" />
                <GradientStop Offset="1" Color="#211737" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0B1020" />
                <GradientStop Offset="0.55" Color="#0E1425" />
                <GradientStop Offset="1" Color="#101525" />
            </LinearGradientBrush>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>

            <!-- Native WPF buttons used in the pages share the same rounded, restrained interaction. -->
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.48" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <!-- Settings selectors keep the stock WPF ComboBox template so mouse, keyboard,
                 focus, and popup item realization work normally. The brushes remain theme-aware. -->
            <Style x:Key="ThemeAwareSettingsComboBox"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <!-- ComboBox popup rows need explicit palette bindings: otherwise WPF can retain the
                 light-theme foreground/background in Dark mode (language and DNS selectors). -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppNavPointerBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppNavSelectedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="5" />
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Margin" Value="2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
